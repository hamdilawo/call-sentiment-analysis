# --- Image de base ---
FROM python:3.11-slim

# --- Variables d'environnement ---
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# --- Dépendances système nécessaires à librosa/soundfile (décodage audio) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# --- Installation des dépendances Python (mise en cache Docker séparée du code) ---
# torch est installé séparément en version CPU-only : la version par défaut
# (pip install torch) télécharge les paquets CUDA/GPU (plusieurs Go inutiles,
# le conteneur n'a pas accès au GPU), ce qui rend le build extrêmement lent.
COPY requirements.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt

# --- Copie du code applicatif ---
COPY app/ ./app/
COPY audio_samples/ ./audio_samples/

# --- Port exposé par l'API FastAPI ---
EXPOSE 8000

# --- Healthcheck simple pour vérifier que l'API répond ---
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# --- Commande de lancement : l'API FastAPI ---
# (pour lancer Gradio à la place, remplacer par : CMD ["python", "-m", "app.gradio_app"])
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
